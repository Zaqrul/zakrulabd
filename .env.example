# Tawk.to live chat. Find these in the Tawk.to dashboard under
# Administration -> Chat Widget; the embed URL is
# https://embed.tawk.to/<PROPERTY_ID>/<WIDGET_ID>
# Leave unset to disable the widget entirely.
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=default

# Google Analytics 4 measurement ID (Admin -> Data streams -> Web).
# Leave unset locally so dev traffic never lands in the production property.
NEXT_PUBLIC_GA_ID=

# Search Console meta-tag verification: the content value of the tag Google
# shows, e.g. "abc123...". Leave unset if you verify by DNS TXT in Cloudflare.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Resend API key for the /contact form. Server-side only: a NEXT_PUBLIC_ name
# would ship the key in the browser bundle and let anyone send mail as this
# domain. Create it at resend.com/api-keys with send-only permission.
RESEND_API_KEY=

# Supabase Realtime, used only for the "people on the site now" count in the
# contact deck. No table is needed: the count comes from a Presence channel.
# Project Settings -> API. The anon key is meant to be public. Leave unset to
# hide the count.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
